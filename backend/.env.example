# Copy to backend/.env for local overrides. Never commit real credentials.
DATABASE_URL=sqlite:///./acme_salary_manager.db
# Comma-separated origins allowed to call the API from a separately hosted UI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve a built UI from the API (set automatically in the container image).
# FRONTEND_DIST_DIR=../frontend/dist
